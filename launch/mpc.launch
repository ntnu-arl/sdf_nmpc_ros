<?xml version="1.0"?>
<launch>
    <!-- args -->
    <arg name="cfg" default="gz"/>

    <arg name="rebuild" default="false"/>
    <arg name="vae" default="true"/>
    <arg name="viz_2d" default="false"/>
    <arg name="viz_3d" default="false"/>

    <param name="/cfg" value="$(arg cfg)"/>

    <!-- SDF NMPC -->
    <node if="$(arg rebuild)" pkg="sdf_nmpc_ros" type="build_solver.py" name="build_solver" output="screen" />
    <node pkg="sdf_nmpc_ros" type="sdfnmpc_node.py" name="sdfnmpc_node" output="screen"/>

    <!-- reference generator -->
    <node pkg="sdf_nmpc_ros" type="ref_gen_node.py" name="ref_gen_node" output="screen"/>

    <!-- VAE -->
    <node if="$(arg vae)" pkg="sdf_nmpc_ros" type="vae_node.py" name="vae_node" output="screen"/>

    <!-- visualization -->
    <include if="$(arg viz_2d)" file="$(find sdf_nmpc_ros)/launch/viz_2d.launch" >
        <arg name="cfg" value="$(arg cfg)"/>
    </include>
    <include if="$(arg viz_3d)" file="$(find sdf_nmpc_ros)/launch/viz_3d.launch" >
        <arg name="cfg" value="$(arg cfg)"/>
    </include>
</launch>
