<?xml version="1.0"?>
<launch>
    <!-- args -->
    <arg name="cfg" default="gbplanner_rotors"/>
    <param name="/cfg" value="$(arg cfg)"/>

    <arg name="rebuild" default="false"/>
    <param name="/rebuild" value="$(arg rebuild)"/>

    <arg name="vae" default="true"/>

    <!-- SDF NMPC -->
    <node pkg="sdf_nmpc_ros" type="sdfnmpc_node.py" name="sdfnmpc_node" output="screen" launch-prefix="taskset -c 0-1"/>

    <!-- reference generator -->
    <node pkg="sdf_nmpc_ros" type="ref_gen_node.py" name="ref_gen_node" output="screen" launch-prefix="taskset -c 2"/>

    <!-- VAE -->
    <node if="$(arg vae)" pkg="sdf_nmpc_ros" type="vae_node.py" name="vae_node" output="screen" launch-prefix="taskset -c 3"/>
</launch>
